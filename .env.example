# Nowlert production Compose defaults.
# Copy this file to .env and adjust it on the deployment host.

NOWLERT_IMAGE=theriark/nowlert-ce:3.1.6
NOWLERT_UID=1000
NOWLERT_GID=1000
NOWLERT_SMTP_PORT=8025
NOWLERT_HTTP_PORT=18080
NOWLERT_CONFIG_DIR=./config
NOWLERT_LOG_DIR=./logs
NOWLERT_SECRETS_DIR=./secrets
NOWLERT_STATE_DIR=./state
NOWLERT_EXTERNAL_BACKUP_DIR=./external-backups

TZ=Europe/Lisbon

# Optional version advertised by deployment automation. When newer than the
# running image, the WebUI shows a non-dismissible update notice.
NOWLERT_AVAILABLE_VERSION=

# Optional mailbox OAuth applications. Each self-hosted Nowlert instance uses
# OAuth applications registered by that instance operator. No Theriark OAuth
# secret is shipped in the repository or container image.
# Client secrets should be mounted as files under /run/secrets. Direct
# NOWLERT_EMAIL_*_CLIENT_SECRET environment values remain compatibility-only.
NOWLERT_EMAIL_GMAIL_CLIENT_ID=
NOWLERT_EMAIL_GMAIL_CLIENT_SECRET_FILE=/run/secrets/nowlert_email_gmail_client_secret
NOWLERT_EMAIL_GMAIL_REDIRECT_URI=
NOWLERT_EMAIL_MICROSOFT_CLIENT_ID=
NOWLERT_EMAIL_MICROSOFT_CLIENT_SECRET_FILE=/run/secrets/nowlert_email_microsoft_client_secret
NOWLERT_EMAIL_MICROSOFT_REDIRECT_URI=
NOWLERT_EMAIL_OAUTH_REDIRECT_URI=

# Keep real values only in the untracked .env file or Docker secrets.
NOWLERT_SMTP_PASSWORD=
NOWLERT_ADMIN_TOKEN=
NOWLERT_HARDWARE_TOKEN=
