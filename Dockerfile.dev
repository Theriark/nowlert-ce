FROM python:3.13.14-slim-bookworm@sha256:9d7f287598e1a5a978c015ee176d8216435aaf335ed69ac3c38dd1bbb10e8d64

LABEL org.opencontainers.image.title="Nowlert CE Development" \
      org.opencontainers.image.description="Nowlert Community Edition development environment" \
      org.opencontainers.image.vendor="Theriark" \
      org.opencontainers.image.source="https://github.com/Theriark/nowlert-ce"

WORKDIR /nowlert

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash \
       curl \
       git \
       nano \
       procps \
       iputils-ping \
       netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /nowlert/requirements.txt
COPY config/config.example.yaml /usr/local/share/nowlert/config.example.yaml

RUN pip install \
    --disable-pip-version-check \
    --no-cache-dir \
    -r /nowlert/requirements.txt

CMD ["/nowlert/start.sh"]
