FROM python:3.13.14-slim-bookworm@sha256:9d7f287598e1a5a978c015ee176d8216435aaf335ed69ac3c38dd1bbb10e8d64

LABEL org.opencontainers.image.title="Nowlert CE Development" \
      org.opencontainers.image.description="Nowlert Community Edition development environment" \
      org.opencontainers.image.vendor="Theriark" \
      org.opencontainers.image.source="https://github.com/Theriark/nowlert-ce"

WORKDIR /nowlert

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash \
       curl \
       git \
       nano \
       procps \
       iputils-ping \
       netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /nowlert/requirements.txt
COPY config/config.example.yaml /usr/local/share/nowlert/config.example.yaml

RUN pip install \
    --disable-pip-version-check \
    --no-cache-dir \
    -r /nowlert/requirements.txt

RUN groupadd --gid 1000 nowlert \
    && useradd --uid 1000 --gid 1000 --no-create-home --shell /usr/sbin/nologin nowlert \
    && install -d -o 1000 -g 1000 -m 0700 \
       /nowlert/config /nowlert/logs /nowlert/state /nowlert/external-backups /run/secrets

USER 1000:1000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/health', timeout=3).close()"]

CMD ["/nowlert/start.sh"]
